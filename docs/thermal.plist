<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Example macOS LaunchAgent: runs the thermal HTTP API at login.
  1. Replace /PATH/TO/print-to-thermal with the binary (`command -v print-to-thermal`, or a
     release download from https://github.com/matmar10/thermal/releases).
  2. Set THERMAL_TOKEN (or remove it to run without auth on a trusted LAN).
  3. cp docs/thermal.plist ~/Library/LaunchAgents/thermal.plist
     launchctl load ~/Library/LaunchAgents/thermal.plist
  It reads the same ~/.config/thermal/printer.json as the CLI.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>thermal</string>
  <key>ProgramArguments</key>
  <array>
    <string>/PATH/TO/print-to-thermal</string>
    <string>serve</string>
    <string>--bind</string><string>0.0.0.0:8631</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>THERMAL_TOKEN</key><string>CHANGE-ME</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/thermal.log</string>
</dict>
</plist>
