#!/bin/sh
# Runs the native `print-to-thermal` binary for this machine. The binaries for
# every supported platform ship inside the plugin, in ../libexec/; their SHA-256
# sums are in ../checksums.txt. It needs no network access.
# Source: https://github.com/matmar10/thermal
set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
root=$(dirname -- "$here")

# A locally built binary, for development.
if [ -n "${THERMAL_BIN:-}" ]; then
  exec "$THERMAL_BIN" "$@"
fi

die() {
  echo "print-to-thermal: $*" >&2
  exit 1
}

src="build from source: https://github.com/matmar10/thermal"
case "$(uname -s)" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  MINGW* | MSYS* | CYGWIN*) os=windows ;;
  *) die "no prebuilt binary for $(uname -s); $src" ;;
esac
case "$(uname -m)" in
  arm64 | aarch64) arch=arm64 ;;
  x86_64 | amd64) arch=x86_64 ;;
  *) die "no prebuilt binary for $(uname -m); $src" ;;
esac
asset="print-to-thermal-$os-$arch"
[ "$os" = windows ] && asset="$asset.exe"

bin="$root/libexec/$asset"
[ -f "$bin" ] || die "no bundled binary $asset in this plugin; $src"
# Plugin installs may not preserve the executable bit.
[ -x "$bin" ] || chmod +x "$bin" 2>/dev/null || true

exec "$bin" "$@"
