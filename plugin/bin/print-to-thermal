#!/bin/sh
# Runs print-to-thermal: the Python package in ../thermal/, standard library
# only, so any Python 3.9 or newer will do. Nothing is downloaded or installed.
# Source: https://github.com/matmar10/thermal
set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
root=$(dirname -- "$here")

# THERMAL_PYTHON picks the interpreter; otherwise the first Python 3.9+ found.
ok() {
  "$@" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1
}
if [ -n "${THERMAL_PYTHON:-}" ]; then
  py=$THERMAL_PYTHON
elif ok python3; then
  py=python3
elif ok python; then
  py=python
elif ok py -3; then
  py="py -3"
else
  echo "print-to-thermal: needs Python 3.9 or newer (python3, python or py -3 on PATH, or set THERMAL_PYTHON)" >&2
  exit 1
fi

# The plugin directory goes first on sys.path, so this copy of the package is
# the one imported. -B: never write bytecode caches into the plugin directory.
# shellcheck disable=SC2086 # "py -3" is two words on purpose
exec $py -B -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from thermal.cli import main; sys.exit(main())' "$root" "$@"
